#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug
cmake --build build -j 4
ctest --test-dir build --output-on-failure

expected=$(printf 'Folder/Second note.md\nWelcome.md')
actual=$(build/vault-inspect tests/fixtures/sample)
if [[ "$actual" != "$expected" ]]; then
  printf 'Unexpected fixture vault listing:\n%s\n' "$actual" >&2
  exit 1
fi
printf '%s\n' "$actual"

#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  --system)
    if [[ $EUID -ne 0 ]]; then echo 'Run with sudo: sudo ./install --system' >&2; exit 1; fi
    if ! command -v apt-get >/dev/null; then echo 'Ubuntu/Debian apt is required for --system.' >&2; exit 1; fi
    packages=(build-essential cmake qt6-base-dev qt6-base-dev-tools)
    missing=()
    for pkg in "${packages[@]}"; do
      dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || missing+=("$pkg")
    done
    if ((${#missing[@]})); then
      apt-get update
      apt-get install -y "${missing[@]}"
    fi
    ;;
  *)
    echo 'Usage: sudo ./install --system' >&2
    exit 1
    ;;
esac

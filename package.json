{
  "name": "inkstow-sandcastle-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test .sandcastle/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sandcastle": "tsx .sandcastle/main.mts",
    "sandcastle:build-image": "sandcastle build-image --dockerfile .sandcastle/Dockerfile --image-name sandcastle:inkstow-pi"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@types/node": "25.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  }
}
